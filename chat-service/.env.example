# ── Server ────────────────────────────────────────────────────────────────────
# Port the chat-service HTTP server listens on
PORT=4000

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL of the Next.js frontend — Socket.IO will only accept handshakes from here
CLIENT_URL=http://localhost:3000

# ── FastAPI backend ────────────────────────────────────────────────────────────
# Internal URL of the FastAPI backend — used to persist messages via REST calls
BACKEND_URL=http://127.0.0.1:8000

# ── Redis (future scaling) ─────────────────────────────────────────────────────
# Uncomment and fill in when adding a Redis adapter for multi-instance scaling.
# At that point, replace the in-process Socket.IO server with:
#   const { createAdapter } = require('@socket.io/redis-adapter');
#   const { createClient } = require('redis');
#
# REDIS_URL=redis://localhost:6379
